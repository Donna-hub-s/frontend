# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# fichiers d'assistants générés localement par `next dev`
/AGENTS.md
/CLAUDE.md

# Superdesign — fichiers temporaires (HTML importé manuellement)
/.superdesign/tmp/

# npm run perf (scripts/measure-web-vitals.mjs) — rapports horodatés, jamais commités
/perf-reports/

# npm run test:e2e (Playwright)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
